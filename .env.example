# Chave que cifra as credenciais do n8n; gerar uma vez e guardar uma cópia segura.
N8N_ENCRYPTION_KEY=

# URL base dos webhooks, com barra final; trocar pela URL HTTPS do túnel nos testes externos.
WEBHOOK_URL=

# Fuso dos agendamentos do n8n; usar America/Sao_Paulo no ambiente local.
GENERIC_TIMEZONE=

# Fuso do sistema do container; usar America/Sao_Paulo no ambiente local.
TZ=
