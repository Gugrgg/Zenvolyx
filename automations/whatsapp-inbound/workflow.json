      "id": "e3b0c442-0007-4f19-9a19-000000000007",
      "name": "WhatsApp events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 100],
      "webhookId": "8a1d4e6b-2c93-4f19-b7d5-3e6f0a9c2b10"
    },
    {
      "parameters": {
        "action": "hmac",
        "binaryData": true,
        "binaryPropertyName": "data",
        "type": "SHA256",
        "dataPropertyName": "computedSignature",
        "encoding": "hex"
      },
      "id": "e3b0c442-0008-4f19-9a19-000000000008",
      "name": "Compute signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [220, 100]
    },
    {
      "parameters": {
        "jsCode": "const BSUID = /^[A-Z]{2}\\.[A-Za-z0-9.]{1,150}$/;\nconst DIGITS = /^[0-9]{1,30}$/;\nconst MAX_ID_LENGTH = 200;\nconst MAX_TEXT_LENGTH = 4096;\nconst MAX_NAME_LENGTH = 100;\nconst IGNORED_TYPES = ['reaction', 'system', 'request_welcome'];\n\nfunction log(event, details = {}) {\n  console.log(JSON.stringify({ event, ...details }));\n}\n\nfunction signatureMatches(json) {\n  const header = json.headers?.['x-hub-signature-256'];\n  const computed = json.computedSignature;\n  if (typeof header !== 'string' || typeof computed !== 'string' || computed.length === 0) {\n    return false;\n  }\n  const expected = `sha256=${computed}`;\n  if (header.length !== expected.length) return false;\n  let difference = 0;\n  for (let index = 0; index < expected.length; index++) {\n    difference |= header.charCodeAt(index) ^ expected.charCodeAt(index);\n  }\n  return difference === 0;\n}\n\nfunction text(value, maxLength) {\n  return typeof value === 'string' && value.trim().length > 0 ? value.slice(0, maxLength) : null;\n}\n\nfunction matching(value, pattern) {\n  return typeof value === 'string' && pattern.test(value) ? value : null;\n}\n\nfunction isObject(value) {\n  return typeof value === 'object' && value !== null;\n}\n\nfunction list(value) {\n  return Array.isArray(value) ? value.filter(isObject) : [];\n}\n\nfunction errorCodes(errors) {\n  return (Array.isArray(errors) ? errors : []).map((error) => error?.code).filter(Number.isInteger);\n}\n\nfunction content(message) {\n  if (message.type === 'text') {\n    const body = text(message.text?.body, MAX_TEXT_LENGTH);\n    if (body !== null) return { type: 'text', text: body, replyId: null };\n  }\n  if (message.type === 'interactive') {\n    const reply = message.interactive?.button_reply ?? message.interactive?.list_reply;\n    const replyId = text(reply?.id, MAX_ID_LENGTH);\n    if (replyId !== null) return { type: 'reply', text: text(reply.title, MAX_TEXT_LENGTH), replyId };\n  }\n  return { type: 'unsupported', text: null, replyId: null };\n}\n\nfunction parseMessage(message, contacts, phoneNumberId) {\n  if (IGNORED_TYPES.includes(message.type)) return null;\n  const contact =\n    contacts.find((candidate) => typeof message.from_user_id === 'string' && candidate.user_id === message.from_user_id) ??\n    (contacts.length === 1 ? contacts[0] : undefined);\n  const messageId = text(message.id, MAX_ID_LENGTH);\n  const leadId = matching(message.from_user_id ?? contact?.user_id, BSUID);\n  if (messageId === null || leadId === null) {\n    log('whatsapp_invalid_message', { phoneNumberId });\n    return null;\n  }\n  const seconds = Number(message.timestamp);\n  return {\n    kind: 'message',\n    phoneNumberId,\n    messageId,\n    leadId,\n    phone: matching(message.from ?? contact?.wa_id, DIGITS),\n    name: text(contact?.profile?.name, MAX_NAME_LENGTH),\n    ...content(message),\n    receivedAt: new Date(Number.isFinite(seconds) && seconds > 0 ? seconds * 1000 : Date.now()).toISOString(),\n  };\n}\n\n// Mensagem que a equipe mandou pelo app (coexistência): pausa o lead. O BSUID pode não vir.\nfunction parseEcho(echo, phoneNumberId) {\n  const messageId = text(echo.id, MAX_ID_LENGTH);\n  const leadId = matching(echo.to_user_id, BSUID);\n  const phone = matching(echo.to, DIGITS);\n  if (messageId === null || (leadId === null && phone === null)) {\n    log('whatsapp_invalid_echo', { phoneNumberId });\n    return null;\n  }\n  return { kind: 'echo', phoneNumberId, messageId, leadId, phone };\n}\n\nfunction parseChange(change) {\n  // history, smb_app_state_sync e account_update são descartados (D013).\n  const field = change?.field;\n  if ((field !== 'messages' && field !== 'smb_message_echoes') || !isObject(change.value)) return [];\n  const value = change.value;\n  const phoneNumberId = matching(value.metadata?.phone_number_id, DIGITS);\n  if (phoneNumberId === null) {\n    log('whatsapp_invalid_payload');\n    return [];\n  }\n  if (field === 'smb_message_echoes') {\n    return list(value.message_echoes)\n      .map((echo) => parseEcho(echo, phoneNumberId))\n      .filter((echo) => echo !== null);\n  }\n  for (const status of list(value.statuses)) {\n    if (status.status === 'failed') {\n      log('whatsapp_failed_status', { phoneNumberId, errorCodes: errorCodes(status.errors) });\n    }\n  }\n  if (Array.isArray(value.errors) && value.errors.length > 0) {\n    log('whatsapp_webhook_error', { phoneNumberId, errorCodes: errorCodes(value.errors) });\n  }\n  const contacts = list(value.contacts);\n  return list(value.messages)\n    .map((message) => parseMessage(message, contacts, phoneNumberId))\n    .filter((message) => message !== null);\n}\n\nfunction parseEvents(json) {\n  if (!signatureMatches(json)) {\n    log('whatsapp_invalid_signature');\n    return [];\n  }\n  const body = json.body;\n  if (body?.object !== 'whatsapp_business_account' || !Array.isArray(body.entry)) {\n    log('whatsapp_unexpected_payload');\n    return [];\n  }\n  return body.entry.flatMap((entry) => list(entry?.changes)).flatMap(parseChange);\n}\n\nreturn $input.all().flatMap((item) => parseEvents(item.json).map((json) => ({ json })));"
      },
