    {
      "parameters": {
        "jsCode": "function log(event, details = {}) {\n  console.log(JSON.stringify({ event, ...details }));\n}\n\nfunction buildItem(result, parsed) {\n  if (Array.isArray(result.invalidConfigs) && result.invalidConfigs.length > 0) {\n    log('client_configs_invalid', { folders: result.invalidConfigs });\n  }\n  if (result.found !== true) {\n    log('whatsapp_unknown_client', { phoneNumberId: parsed.phoneNumberId, reason: result.reason ?? 'unknown' });\n    return [];\n  }\n  if (parsed.kind === 'echo') {\n    log('whatsapp_team_reply', { clientId: result.config.id });\n    return [{ kind: 'echo', clientId: result.config.id, leadKey: parsed.leadId ?? `tel:${parsed.phone}` }];\n  }\n  return [\n    {\n      kind: 'message',\n      event: {\n        clientId: result.config.id,\n        channel: 'whatsapp',\n        leadId: parsed.leadId,\n        phone: parsed.phone,\n        name: parsed.name,\n        messageIds: [parsed.messageId],\n        type: parsed.type,\n        text: parsed.text,\n        replyId: parsed.replyId,\n        receivedAt: parsed.receivedAt,\n      },\n      config: result.config,\n    },\n  ];\n}\n\nreturn $input.all().flatMap((item, index) =>\n  buildItem(item.json, $('Is new message').itemMatching(index).json).map((json) => ({ json })),\n);"
      },
