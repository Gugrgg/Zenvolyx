      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1760, 400],
      "webhookId": "6c2f0d8e-3a41-4f20-9a20-b5e7c1d9a020"
    },
    {
      "parameters": {
        "jsCode": "// Uma entrada por lead, com o maior ID que esta execução gravou na tabela de rajadas.\nconst leads = new Map();\nfor (const { json: row } of $input.all()) {\n  const key = `${row.clientId} ${row.leadId}`;\n  const current = leads.get(key);\n  if (current === undefined || row.id > current.ownMaxId) {\n    leads.set(key, { clientId: row.clientId, leadId: row.leadId, ownMaxId: row.id });\n  }\n}\nreturn [...leads.values()].map((json) => ({ json }));"
      },
      "id": "e3b0c442-0007-4f20-9a20-000000000007",
      "name": "Latest per lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 400]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "whatsapp_message_buffer",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "clientId",
              "condition": "eq",
              "keyValue": "={{ $json.clientId }}"
            },
            {
              "keyName": "leadId",
              "condition": "eq",
              "keyValue": "={{ $json.leadId }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "e3b0c442-0008-4f20-9a20-000000000008",
      "name": "Read burst",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [2200, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "whatsapp_lead_pauses",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "clientId",
              "condition": "eq",
              "keyValue": "={{ $json.clientId }}"
            },
            {
              "keyName": "pausedUntil",
              "condition": "gt",
              "keyValue": "={{ $now.toISO() }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "e3b0c442-0009-4f20-9a20-000000000009",
      "name": "Read pause",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [2200, 500],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "function log(event, details = {}) {\n  console.log(JSON.stringify({ event, ...details }));\n}\n\nfunction sameLead(item, lead) {\n  return item.clientId === lead.clientId && item.leadId === lead.leadId;\n}\n\n// Mídia vai para a equipe; resposta de botão ou lista vale a última.\nfunction burstType(rows) {\n  if (rows.some((row) => row.type === 'unsupported')) return 'unsupported';\n  if (rows.some((row) => row.type === 'reply')) return 'reply';\n  return 'text';\n}\n\nfunction groupedEvent(rows, latest) {\n  const type = burstType(rows);\n  const replies = rows.filter((row) => row.type === 'reply');\n  const texts = rows.map((row) => row.text).filter((value) => typeof value === 'string' && value.length > 0);\n  return {\n    ...latest,\n    messageIds: rows.map((row) => row.messageId),\n    type,\n    text: texts.length > 0 ? texts.join('\\n') : null,\n    replyId: type === 'reply' ? replies[replies.length - 1].replyId : null,\n    receivedAt: rows[rows.length - 1].receivedAt,\n  };\n}\n\nconst rows = $('Read burst')\n  .all()\n  .map((item) => item.json)\n  .filter((row) => Number.isInteger(row.id));\nconst pauses = $input\n  .all()\n  .map((item) => item.json)\n  .filter((pause) => typeof pause.leadKey === 'string');\nconst messages = $('Build event')\n  .all()\n  .map((item) => item.json)\n  .filter((item) => item.kind === 'message');\n\nreturn $('Latest per lead')\n  .all()\n  .flatMap(({ json: lead }) => {\n    const leadRows = rows.filter((row) => sameLead(row, lead)).sort((a, b) => a.id - b.id);\n    const latest = messages.filter((item) => sameLead(item.event, lead)).at(-1);\n    // Só a execução da mensagem mais recente responde; as anteriores param aqui.\n    if (latest === undefined || leadRows.at(-1)?.id !== lead.ownMaxId) return [];\n    const keys = [lead.leadId];\n    if (latest.event.phone !== null) keys.push(`tel:${latest.event.phone}`);\n    const paused = pauses.some((pause) => pause.clientId === lead.clientId && keys.includes(pause.leadKey));\n    if (paused) log('whatsapp_paused_lead', { clientId: lead.clientId });\n    return [\n      {\n        json: {\n          clientId: lead.clientId,\n          leadId: lead.leadId,\n          maxRowId: lead.ownMaxId,\n          paused,\n          event: groupedEvent(leadRows, latest.event),\n          config: latest.config,\n        },\n      },\n    ];\n  });"
      },
