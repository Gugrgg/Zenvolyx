      "id": "e3b0c442-0002-4f19-9a19-000000000002",
      "name": "Show verify token for Meta",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, -250]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "zenvolyx-whatsapp-webhook",
        "dataPropertyName": "expectedToken",
        "encoding": "hex"
      },
      "id": "e3b0c442-0003-4f19-9a19-000000000003",
      "name": "Derive verify token (HMAC)",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [220, -325]
    },
    {
      "parameters": {
        "jsCode": "const CHALLENGE_PATTERN = /^[A-Za-z0-9_-]{1,200}$/;\n\nfunction sameText(received, expected) {\n  if (typeof received !== 'string' || typeof expected !== 'string' || received.length !== expected.length) {\n    return false;\n  }\n  let difference = 0;\n  for (let index = 0; index < expected.length; index++) {\n    difference |= received.charCodeAt(index) ^ expected.charCodeAt(index);\n  }\n  return difference === 0;\n}\n\nfunction verification(json) {\n  // Execução manual pelo gatilho \"Show verify token for Meta\": mostra o valor para o painel da Meta.\n  if (json.query === undefined) {\n    return { fromMeta: false, verifyToken: json.expectedToken };\n  }\n  const query = json.query ?? {};\n  const challenge = query['hub.challenge'];\n  const accepted =\n    query['hub.mode'] === 'subscribe' &&\n    typeof challenge === 'string' &&\n    CHALLENGE_PATTERN.test(challenge) &&\n    sameText(query['hub.verify_token'], json.expectedToken);\n  if (!accepted) {\n    console.log(JSON.stringify({ event: 'whatsapp_verification_rejected' }));\n    return { fromMeta: true, status: 403, body: '' };\n  }\n  return { fromMeta: true, status: 200, body: challenge };\n}\n\nreturn $input.all().map((item) => ({ json: verification(item.json) }));"
      },
